<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.debezium</groupId>
    <artifactId>debezium-rps-custom-bom</artifactId>
    <version>3.6.2-20260916.Final</version>
    <packaging>pom</packaging>

    <name>Debezium RPS Custom BOM</name>
    <description>Overrides only Debezium components whose production code is customized for RPS.</description>

    <properties>
        <debezium.upstream.version>3.6.2.Final</debezium.upstream.version>
        <version.mysql-binlog-client.rps>0.41.2-20260916.Final</version.mysql-binlog-client.rps>
        <version.debezium.rps.connector-common>3.6.2-20260916.Final</version.debezium.rps.connector-common>
        <version.debezium.rps.ddl-parser>3.6.2-20260916.Final</version.debezium.rps.ddl-parser>
        <version.debezium.rps.connector-binlog>3.6.2-20260916.Final</version.debezium.rps.connector-binlog>
        <version.debezium.rps.connector-mysql>3.6.2-20260916.Final</version.debezium.rps.connector-mysql>
        <version.debezium.rps.connector-mariadb>3.6.2-20260916.Final</version.debezium.rps.connector-mariadb>
        <version.debezium.rps.connector-oracle>3.6.2-20260916.Final</version.debezium.rps.connector-oracle>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-bom</artifactId>
                <version>${debezium.upstream.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>dataknown-mysql-binlog-connector-java</artifactId>
                <version>${version.mysql-binlog-client.rps}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-common</artifactId>
                <version>${version.debezium.rps.connector-common}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-ddl-parser</artifactId>
                <version>${version.debezium.rps.ddl-parser}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-binlog</artifactId>
                <version>${version.debezium.rps.connector-binlog}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-mysql</artifactId>
                <version>${version.debezium.rps.connector-mysql}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-mariadb</artifactId>
                <version>${version.debezium.rps.connector-mariadb}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-oracle</artifactId>
                <version>${version.debezium.rps.connector-oracle}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
