<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.debezium</groupId>
    <artifactId>debezium-rps-custom-bom</artifactId>
    <version>3.6.2-20260916.Final</version>
    <packaging>pom</packaging>

    <name>Debezium RPS Custom BOM</name>
    <description>Overrides only Debezium components whose production code is customized for RPS.</description>

    <properties>
        <debezium.upstream.version>3.6.2.Final</debezium.upstream.version>
        <debezium.rps.version>3.6.2-20260916.Final</debezium.rps.version>
        <mysql.binlog.rps.version>0.41.2-20260916.Final</mysql.binlog.rps.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-bom</artifactId>
                <version>${debezium.upstream.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>dataknown-mysql-binlog-connector-java</artifactId>
                <version>${mysql.binlog.rps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-common</artifactId>
                <version>${debezium.rps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-ddl-parser</artifactId>
                <version>${debezium.rps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-binlog</artifactId>
                <version>${debezium.rps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-mysql</artifactId>
                <version>${debezium.rps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-mariadb</artifactId>
                <version>${debezium.rps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.debezium</groupId>
                <artifactId>debezium-connector-oracle</artifactId>
                <version>${debezium.rps.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
